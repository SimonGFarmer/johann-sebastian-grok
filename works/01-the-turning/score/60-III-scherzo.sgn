fg:   =vn1 -16 @b1-4
fg:   | R*4 | 4 {ff} g2^ r r | 4 d2^ r r | 4 g2^ r r | 2 d2^ 4 r |
fl:   =vn1 @b5-8
ob:   =vn1 -8 @b5-7
ob:   | R*7 | 2 (f#4 a4)^ 4 r |
cl:   | R*4 | 2. {ff} (bb3 d4) | 2. (a3 d4) | 2. (bb3 d4) | 2 (a3 f#4)^ 4 r |
hn12: | R*4 | 4 {ff} (g3 d4)^ r r | 4 (d4 a4)^ r r | 4 (g3 d4)^ r r | 2 (d4 a4)^ 4 r |
hn34: | R*4 | 4 {ff} (bb3 d4)^ r r | 4 d4^ r r | 4 (bb3 d4)^ r r | 2 d4^ 4 r |
tp:   | R*4 | 4 {ff} (g4 d5)^ r r | 4 (d4 d5)^ r r | 4 (g4 d5)^ r r | 2 (d4 d5)^ 4 r |
timp: | R*4 | 4 {ff} g2^ r r | 4 d3^ r r | 4 g2^ r r | 2 d3^ 4 r |

