# -- The Song's first phrase in the shadows: G minor instead of B minor, an
# -- octave and more below, over a high trembling chord (no tremolo patch exists:
# -- the tremolo is written as measured 32nds on the short articulations).
== b55-58 ==
@ T=66 M=4/4 K=bm
@@ b55 T=66 "sotto voce"
vcs:   | {ks:Legato Slur} 4 {p}{"sotto voce"} [d3 8 g3 bb3 2 d4 | 8 c#4 d4 e4 d4 4 c#4 b3 | 4. g4 8 f#4 2 e4 | 4 d4 8 c#4 b3 2 a#3] |
vn1:   | {ks:Staccatissimo RRx9} 1 {pp}{div}{"trem."} (bb5 d6)=32 | 1 (b5 e6)=32 | 1 (b5 e6)=32 | 1 (a#5 e6)=32 |
vn2:   | {ks:Stac On Bow RRx9} 1 {pp}{div}{"trem."} (d5 g5)=32 | 1 (c#5 e5)=32 | 1 (b4 e5)=32 | 1 (c#5 e5)=32 |
va:    | {ks:Staccatissimo RRx16} 1 {pp}{div}{"trem."} (g4 bb4)=32 | 1 (g4 b4)=32 | 1 (g4 b4)=32 | 1 (f#4 a#4)=32 |
cb:    | {ks:Sus MAX} 1 {pp} g1 | 1 e1 | 1 g1 | 1 f#1 |

# -- b59-62 CADENZA over the dominant pedal F#: arpeggio up all four strings,
# -- a scale run, the held F#5 (fermata, written as T=44), and a run down to F#3.
# -- b63-65: the cello alone again, low, the Dusk voice: F#-B-D on the C string.
== b59-65 ==
@ T=60 M=4/4 K=bm
@@ b59 T=60 "quasi cadenza, ad lib."
@@ b60 T=66
@@ b61 T=44
@@ b62 T=50
@@ b63 T=56 "Tempo I, lontano"
vcs:   | {ks:Legato Slur} 8t {mp}{<} [f#3 a#3 c#4 f#4 a#4 c#5 4 {mf} e5 8 d5 c#5 | 16 b4 c#5 d5 e5 f#5 e5 d5 c#5 4 d5 8 b4 g5 | 2 {f} f#5~* 8t f#5 {>} e5 d5 c#5 b4 a#4 | 16 {mp} g4 f#4 e4 d4 c#4 b3 a#3 g3 2 {p} f#3] | 4. {pp}{"come da lontano"} [f#2 8 b2 2 d3 | 8 c#3 d3 e3 d3 4 c#3 b2 | 4. a#2 8 c#3 2 f#3] |
